{
  "id": "signs-messages",
  "title": "Signs & Messages",
  "order": 20,
  "summary": "Read short notices and reply to simple everyday messages — exam-style survival.",
  "sections": [
    {
      "type": "text",
      "content": "Official A1 reading leans on cartells, anuncis, and short web/info texts. Writing is brief replies (often chat-like). This lesson drills those shapes with the practice tools we have."
    },
    {
      "type": "rule",
      "content": "Scan for key words: obert/tancat, gratis, prohibit, entrada, sortida. Chat replies: D'acord., Fins demà., Sí, gràcies., No puc."
    },
    {
      "type": "examples",
      "items": [
        {
          "catalan": "Obert de 9 a 14 h",
          "english": "Open from 9 to 2",
          "note": "notice / sign"
        },
        {
          "catalan": "Entrada gratuïta",
          "english": "Free entry",
          "note": ""
        },
        {
          "catalan": "Prohibit fumar",
          "english": "No smoking",
          "note": ""
        },
        {
          "catalan": "D'acord. Fins demà!",
          "english": "OK. See you tomorrow!",
          "note": "chat reply"
        },
        {
          "catalan": "No puc avui. Demà?",
          "english": "I can't today. Tomorrow?",
          "note": "chat reply"
        }
      ]
    }
  ],
